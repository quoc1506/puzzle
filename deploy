: << 'BATCH'
@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"

if exist "bin\build-windows-x86_64.exe" (
    "bin\build-windows-x86_64.exe" %*
    exit /b !ERRORLEVEL!
)

if exist "bin\build-windows-x86_64-compat.exe" (
    "bin\build-windows-x86_64-compat.exe" %*
    exit /b !ERRORLEVEL!
)

if exist "bin\build.exe" (
    "bin\build.exe" %*
    exit /b !ERRORLEVEL!
)

exit /b 1
BATCH

#!/usr/bin/env sh
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

OS="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m 2>/dev/null | tr '[:upper:]' '[:lower:]')"

TARGET_BIN=""

case "$OS" in
    linux*)
        if [ -f "bin/build-linux-x86_64" ]; then
            TARGET_BIN="bin/build-linux-x86_64"
        elif [ -f "bin/build-linux-x86_64-compat" ]; then
            TARGET_BIN="bin/build-linux-x86_64-compat"
        elif [ -f "bin/build" ]; then
            TARGET_BIN="bin/build"
        else
            TARGET_BIN="bin/build-linux-x86_64"
        fi
        ;;
    darwin*)
        if [ "$ARCH" = "arm64" ] || [ "$ARCH" = "aarch64" ]; then
            if [ -f "bin/build-macos-arm64" ]; then
                TARGET_BIN="bin/build-macos-arm64"
            elif [ -f "bin/build-macos-universal" ]; then
                TARGET_BIN="bin/build-macos-universal"
            else
                TARGET_BIN="bin/build-macos-x86_64"
            fi
        else
            if [ -f "bin/build-macos-x86_64" ]; then
                TARGET_BIN="bin/build-macos-x86_64"
            elif [ -f "bin/build-macos-universal" ]; then
                TARGET_BIN="bin/build-macos-universal"
            else
                exit 1
            fi
        fi
        ;;
    msys*|mingw*|cygwin*)
        if [ -f "bin/build-windows-x86_64.exe" ]; then
            TARGET_BIN="bin/build-windows-x86_64.exe"
        elif [ -f "bin/build-windows-x86_64-compat.exe" ]; then
            TARGET_BIN="bin/build-windows-x86_64-compat.exe"
        else
            TARGET_BIN="bin/build-windows-x86_64.exe"
        fi
        ;;
    *)
        TARGET_BIN="bin/build-linux-x86_64"
        ;;
esac

if [ -n "$TARGET_BIN" ] && [ -f "$TARGET_BIN" ]; then
    chmod +x "$TARGET_BIN" 2>/dev/null || true
    if [ "$TARGET_BIN" = "bin/build-linux-x86_64" ] && [ -f "bin/build-linux-x86_64-compat" ]; then
        if ! "./$TARGET_BIN" "$@" 2>/dev/null; then
            chmod +x "bin/build-linux-x86_64-compat" 2>/dev/null || true
            exec "./bin/build-linux-x86_64-compat" "$@"
        fi
        exit 0
    else
        exec "./$TARGET_BIN" "$@"
    fi
fi

if [ -f "bin/build" ]; then
    chmod +x "bin/build" 2>/dev/null || true
    exec "./bin/build" "$@"
fi

exit 1
