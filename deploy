: << 'BATCH'
@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"

if exist "bin\build-windows-x86_64.exe" (
    "bin\build-windows-x86_64.exe" %*
    exit /b %ERRORLEVEL%
)

if exist "bin\build.exe" (
    "bin\build.exe" %*
    exit /b %ERRORLEVEL%
)

echo [ERROR] No Windows binary found in bin/
exit /b 1
BATCH

#!/usr/bin/env sh
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

OS="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m 2>/dev/null | tr '[:upper:]' '[:lower:]')"

TARGET_BIN=""

case "$OS" in
    linux*)
        TARGET_BIN="bin/build-linux-x86_64"
        ;;
    darwin*)
        if [ "$ARCH" = "arm64" ] || [ "$ARCH" = "aarch64" ]; then
            if [ -f "bin/build-macos-arm64" ]; then
                TARGET_BIN="bin/build-macos-arm64"
            elif [ -f "bin/build-macos-universal" ]; then
                TARGET_BIN="bin/build-macos-universal"
            else
                TARGET_BIN="bin/build-macos-x86_64"
            fi
        else
            # Intel Mac (x86_64) - Do NOT fallback to arm64 to avoid Bad CPU type crash
            if [ -f "bin/build-macos-x86_64" ]; then
                TARGET_BIN="bin/build-macos-x86_64"
            elif [ -f "bin/build-macos-universal" ]; then
                TARGET_BIN="bin/build-macos-universal"
            else
                echo "[ERROR] You are running on an Intel Mac ($ARCH), but 'bin/build-macos-x86_64' was not found!"
                echo "Only 'bin/build-macos-arm64' (Apple Silicon) exists in your bin/ folder."
                echo "Please compile or download 'bin/build-macos-x86_64'."
                exit 1
            fi
        fi
        ;;
    msys*|mingw*|cygwin*)
        TARGET_BIN="bin/build-windows-x86_64.exe"
        ;;
    *)
        TARGET_BIN="bin/build-linux-x86_64"
        ;;
esac

if [ -n "$TARGET_BIN" ] && [ -f "$TARGET_BIN" ]; then
    chmod +x "$TARGET_BIN" 2>/dev/null || true
    exec "./$TARGET_BIN" "$@"
fi

if [ -f "bin/build" ]; then
    chmod +x "bin/build" 2>/dev/null || true
    exec "./bin/build" "$@"
fi

echo "[ERROR] Executable binary not found for OS=$OS, ARCH=$ARCH in directory: $DIR/bin"
echo "Attempted: $DIR/$TARGET_BIN"
if [ -d "bin" ]; then
    echo "Files currently in bin/:"
    ls -la bin/
fi
exit 1
